; Vertex shader de A Brick Cube 3DS.
; La GPU transforma cada vértice con una sola matriz (proyección * vista,
; ya corregida para la pantalla girada de 3DS).
.fvec mvp[4]
.constf k(0.00392156862745, 1.0, 0.0, 0.0)   ; 1/255, 1
.out outpos position
.out outclr color
.alias inpos v0
.alias inclr v1

.proc main
    mov r0.xyz, inpos
    mov r0.w, k.y

    dp4 outpos.x, mvp[0], r0
    dp4 outpos.y, mvp[1], r0
    dp4 outpos.z, mvp[2], r0
    dp4 outpos.w, mvp[3], r0

    mul outclr, k.xxxx, inclr
    end
.end
